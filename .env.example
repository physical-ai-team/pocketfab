# 이 파일을 .env로 복사해서 쓴다: Copy-Item .env.example .env
# docker compose가 .env를 자동으로 읽는다. (.env는 git에 올라가지 않음)

# 스마트폰이 접속할 PC의 LAN IP (QR코드와 인증서에 들어감)
# 확인: Get-NetIPAddress -AddressFamily IPv4 | Where-Object InterfaceAlias -match 'Wi-Fi'
PUBLIC_HOST=192.168.0.10

# C1 백프레셔: 동시에 처리 중일 수 있는 프레임 수
# 비워두면 C3 복제본 수 × IN_FLIGHT_PER_REPLICA로 자동 결정된다 (--scale을 바꾸면 5초 안에 따라감).
# 값을 넣으면 자동 계산 대신 그 값을 쓴다.
MAX_IN_FLIGHT=
IN_FLIGHT_PER_REPLICA=1

# C3
SEGMENTER=opencv
DEVICE=cpu
TORCH_NUM_THREADS=4
CIRCULARITY_THRESHOLD=0.80
SOLIDITY_THRESHOLD=0.95
FILL_RATIO_THRESHOLD=0.94

# 박스 검출(C2)을 구현하기 전에는 false로 두어야 프레임이 C3까지 흐른다
SKIP_C3_IF_NO_BOXES=false

# SAM 2 없이 추론 시간을 흉내 낼 때(ms). 로드밸런싱·백프레셔 시험용
SIMULATED_INFER_MS=0
